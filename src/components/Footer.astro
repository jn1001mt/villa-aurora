---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();

const navLinks = [
  { label: 'Início', href: '/' },
  { label: 'Ambientes', href: '/ambientes' },
  { label: 'Eventos', href: '/eventos' },
  { label: 'Galeria', href: '/galeria' },
  { label: 'Pacotes', href: '/pacotes' },
  { label: 'Buffet', href: '/buffet' },
  { label: 'Contato', href: '/contato' },
];

const eventTypes = [
  { label: 'Casamentos', href: '/eventos#casamentos' },
  { label: 'Aniversários & 15 Anos', href: '/eventos#aniversarios' },
  { label: 'Formaturas', href: '/eventos#formaturas' },
  { label: 'Eventos Corporativos', href: '/eventos#corporativos' },
];

const whatsappNumber = '5511999999999';
const whatsappMessage = encodeURIComponent('Olá! Gostaria de mais informações sobre o Villa Aurora.');
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<footer class="site-footer" aria-label="Rodapé do site">
  <div class="footer-container">
    <div class="footer-grid">
      <!-- Coluna 1: Marca e Apresentação -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-logo" aria-label="Villa Aurora - Página Inicial">
          <span class="logo-name">VILLA AURORA</span>
          <span class="logo-sub">ESPAÇO DE EVENTOS & BUFFET</span>
        </a>
        <p class="brand-desc">
          O cenário ideal para momentos memoráveis. Infraestrutura sofisticada, atendimento consultivo e alta gastronomia para eventos sociais e corporativos.
        </p>
        <div class="social-links" aria-label="Redes Sociais">
          <a href="#" class="social-btn" aria-label="Instagram (espaço reservado)" title="Instagram">
            <svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a href="#" class="social-btn" aria-label="Facebook (espaço reservado)" title="Facebook">
            <svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
          <a href="#" class="social-btn" aria-label="Pinterest (espaço reservado)" title="Pinterest">
            <svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M8 20l4-9"></path>
              <path d="M10.7 13c.4 1.2 1.3 2 2.8 2 2 0 3.5-1.8 3.5-4 0-2.5-1.8-4-4.5-4-3 0-4.5 2-4.5 4.3 0 1 .4 1.9 1.1 2.4"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Coluna 2: Navegação Institucional -->
      <div class="footer-col">
        <h2 class="col-title">Navegação</h2>
        <ul class="footer-links">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Coluna 3: Modalidades de Eventos -->
      <div class="footer-col">
        <h2 class="col-title">Eventos</h2>
        <ul class="footer-links">
          {eventTypes.map((event) => (
            <li>
              <a href={event.href} class="footer-link">{event.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Coluna 4: Contato & Localização -->
      <div class="footer-col contact-col">
        <h2 class="col-title">Atendimento</h2>
        <ul class="contact-list">
          <li class="contact-item">
            <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <div class="contact-detail">
              <span class="detail-label">WhatsApp & Orçamentos</span>
              <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="detail-value highlight-link">
                (11) 99999-9999
              </a>
            </div>
          </li>
          <li class="contact-item">
            <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <div class="contact-detail">
              <span class="detail-label">E-mail Comercial</span>
              <a href="mailto:contato@villaauroraeventos.com.br" class="detail-value">
                contato@villaauroraeventos.com.br
              </a>
            </div>
          </li>
          <li class="contact-item">
            <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <div class="contact-detail">
              <span class="detail-label">Localização</span>
              <span class="detail-value">São Paulo - SP (visitas com agendamento prévio)</span>
            </div>
          </li>
        </ul>
      </div>
    </div>

    <!-- Divisória Dourada Nobre -->
    <div class="footer-divider" role="separator"></div>

    <!-- Barra Inferior: Copyright -->
    <div class="footer-bottom">
      <p class="copyright-text">
        &copy; {currentYear} Villa Aurora — Espaço de Eventos & Buffet. Todos os direitos reservados.
      </p>
      <p class="footer-note">
        São Paulo - SP &bull; Experiências exclusivas e alta gastronomia
      </p>
    </div>
  </div>
</footer>

<style>
  :root {
    --color-onyx: #201A16;
    --color-onyx-card: #2B221D;
    --color-onyx-deep: #17120F;
    --color-gold: #c5a059;
    --color-gold-light: #dfbd74;
    --color-champagne: #f7f3e9;
    --color-champagne-muted: rgba(247, 243, 233, 0.72);
    --border-gold-subtle: rgba(197, 160, 89, 0.22);
    --border-bronze-subtle: rgba(163, 126, 88, 0.3);
    --font-heading: 'Playfair Display', Georgia, serif;
    --font-sans: 'Montserrat', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .site-footer {
    background-color: var(--color-onyx);
    background: linear-gradient(180deg, var(--color-onyx) 0%, var(--color-onyx-deep) 100%);
    border-top: 1px solid var(--border-gold-subtle);
    color: var(--color-champagne-muted);
    font-family: var(--font-sans);
    padding: 4.5rem 1.5rem 2rem;
  }

  .footer-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  /* Logotipo e Apresentação */
  .brand-col {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .footer-logo {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    gap: 0.2rem;
  }

  .logo-name {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: var(--color-champagne);
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .logo-sub {
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: var(--color-gold);
    text-transform: uppercase;
  }

  .footer-logo:hover .logo-name {
    color: var(--color-gold-light);
  }

  .brand-desc {
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--color-champagne-muted);
    max-width: 380px;
    margin: 0;
  }

  /* Redes Sociais */
  .social-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    border: 1px solid var(--border-gold-subtle);
    color: var(--color-gold);
    background-color: rgba(255, 255, 255, 0.02);
    text-decoration: none;
    transition: transform 0.25s ease, background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease;
  }

  .social-btn:hover {
    transform: translateY(-2px);
    background-color: var(--color-gold);
    border-color: var(--color-gold);
    color: #1C1613;
  }

  .social-icon {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* Títulos de Coluna */
  .col-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin: 0 0 1.25rem 0;
    position: relative;
    padding-bottom: 0.5rem;
  }

  .col-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 24px;
    height: 1.5px;
    background-color: var(--color-gold);
  }

  /* Listas de Links */
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-link {
    color: var(--color-champagne-muted);
    text-decoration: none;
    font-size: 0.88rem;
    letter-spacing: 0.04em;
    transition: color 0.25s ease, padding-left 0.25s ease;
    display: inline-block;
  }

  .footer-link:hover {
    color: var(--color-gold-light);
    padding-left: 0.35rem;
  }

  /* Área de Contato */
  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .contact-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-gold);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .contact-detail {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .detail-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gold-light);
    opacity: 0.9;
  }

  .detail-value {
    font-size: 0.85rem;
    color: var(--color-champagne);
    text-decoration: none;
    line-height: 1.45;
    transition: color 0.25s ease;
  }

  .highlight-link:hover {
    color: var(--color-gold);
  }

  /* Divisória */
  .footer-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-gold-subtle), transparent);
    margin: 3.5rem 0 1.8rem;
  }

  /* Rodapé Inferior */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    color: rgba(247, 243, 233, 0.5);
  }

  .copyright-text {
    margin: 0;
  }

  .footer-note {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
  }

  /* Responsividade para Tablets e Desktops */
  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1.2fr 1.8fr;
      gap: 3rem;
    }

    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
</style>
