---
// src/pages/galeria.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Galeria de Fotos dos Eventos e Ambientes — Villa Aurora";
const pageDescription = "Explore nossa galeria de fotos em alta resolução: Casamentos, 15 Anos, Formaturas, Eventos Corporativos, Ambientes e Alta Gastronomia da Villa Aurora em São Paulo.";

const whatsappNumber = '5511999999999';
const whatsappMsgGaleria = encodeURIComponent('Olá! Estive vendo a galeria de fotos da Villa Aurora e gostaria de solicitar um orçamento para meu evento.');
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMsgGaleria}`;

const categories = [
  { id: 'todos', label: 'Todos' },
  { id: 'casamentos', label: 'Casamentos' },
  { id: 'aniversarios', label: 'Aniversários' },
  { id: '15-anos', label: '15 Anos' },
  { id: 'formaturas', label: 'Formaturas' },
  { id: 'corporativo', label: 'Corporativo' },
  { id: 'ambientes', label: 'Ambientes' },
  { id: 'buffet', label: 'Buffet' }
];

const galleryPhotos = [
  {
    id: 1,
    title: "Mesa Posta Clássica para Casamento Noturno",
    category: "casamentos",
    categoryLabel: "Casamentos",
    image: "https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1200&q=85",
    thumb: "https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=700&q=80",
    description: "Decoração requintada com arranjos florais nobres, castiçais e louças finas no Salão Nobre."
  },
  {
    id: 2,
    title: "Cerimônia Romântica no Jardim Externo",
    category: "casamentos",
    categoryLabel: "Casamentos",
    image: "https://images.unsplash.com/photo-1464366400600-7168b8af9bc3?auto=format&fit=crop&w=1200&q=85",
    thumb: "https://images.unsplash.com/photo-1464366400600-7168b8af9bc3?auto=format&fit=crop&w=700&q=80",
    description: "Cerimônia ao ar livre sob a luz do entardecer com paisagismo exuberante e passarela decorada."
  },
  {
    id: 3,
    title: "Brinde Especial em Festa de Aniversário",
    category: "aniversarios",
    categoryLabel: "Aniversários",
    image: "https://images.unsplash.com/photo-1527529482837-4698179dc6ce?auto=format&fit=crop&w=1200&q=85",
    thumb: "https://images.unsplash.com/photo-1527529482837-4698179dc6ce?auto=format&fit=crop&w=700&q=80",
    description: "Celebração intimista com taças de espumante, iluminação acolhedora e momentos de alegria."
  },
  {
    id: 4,
    title: "Lounge Festivo e Mesa de Doces de 15 Anos",
    category: "15-anos",
    categoryLabel: "15 Anos",
    image: "https://images.unsplash.com/photo-1530103862676-de8c9debad1d?auto=format&fit=crop&w=1200&q=85",
    thumb: "https://images.unsplash.com/photo-1530103862676-de8c9debad1d?auto=format&fit=crop&w=700&q=80",
    description: "Cenografia dourada com iluminação cênica personalizada e atmosfera moderna para debutante."
  },
  {
    id: 5,
    title: "Jantar de Gala e Baile de Formatura",
    category: "formaturas",
    categoryLabel: "Formaturas",
    image: "https://images.unsplash.com/photo-1541339907198-e08756dedf3f?auto=format&fit=crop&w=1200&q=85",
    thumb: "https://images.unsplash.com/photo-1541339907198-e08756dedf3f?auto=format&fit=crop&w=700&q=80",
    description: "Salão preparado para celebração de formatura com mesa de honra e iluminação de destaque."
  },
  {
    id: 6,
    title: "Convenção e Jantar Executivo Corporativo",
    category: "corporativo",
    categoryLabel: "Corporativo",
    image: "https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=1200&q=85",
    thumb: "https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=700&q=80",
    description: "Montagem contemporânea para reuniões corporativas de liderança, palestras e confraternizações."
  },
  {
    id: 7,
    title: "Perspectiva Ampla do Salão Nobre",
    category: "ambientes",
    categoryLabel: "Ambientes",
    image: "https://images.unsplash.com/photo-1519167758481-83f550bb49b3?auto=format&fit=crop&w=1200&q=85",
    thumb: "https://images.unsplash.com/photo-1519167758481-83f550bb49b3?auto=format&fit=crop&w=700&q=80",
    description: "Vão livre sem colunas intermediárias com pé-direito alto e climatização central."
  },
  {
    id: 8,
    title: "Balcão Moderno do Lounge Bar",
    category: "ambientes",
    categoryLabel: "Ambientes",
    image: "https://images.unsplash.com/photo-1572116469696-31de0f17cc34?auto=format&fit=crop&w=1200&q=85",
    thumb: "https://images.unsplash.com/photo-1572116469696-31de0f17cc34?auto=format&fit=crop&w=700&q=80",
    description: "Espaço intimista de coquetelaria com balcão de mármore e iluminação âmbar aconchegante."
  },
  {
    id: 9,
    title: "Pista de Dança com Iluminação Computadorizada",
    category: "ambientes",
    categoryLabel: "Ambientes",
    image: "https://images.unsplash.com/photo-1492684223066-81342ee5ff30?auto=format&fit=crop&w=1200&q=85",
    thumb: "https://images.unsplash.com/photo-1492684223066-81342ee5ff30?auto=format&fit=crop&w=700&q=80",
    description: "Grid aéreo estruturado com efeitos de luz cênica e alta fidelidade acústica."
  },
  {
    id: 10,
    title: "Canapés Finos e Finger Foods Volantes",
    category: "buffet",
    categoryLabel: "Buffet",
    image: "https://images.unsplash.com/photo-1555244162-803834f70033?auto=format&fit=crop&w=1200&q=85",
    thumb: "https://images.unsplash.com/photo-1555244162-803834f70033?auto=format&fit=crop&w=700&q=80",
    description: "Entradas contemporâneas com apresentação estética delicada e sabores sofisticados."
  },
  {
    id: 11,
    title: "Prato Principal Empratado Autoral",
    category: "buffet",
    categoryLabel: "Buffet",
    image: "https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=1200&q=85",
    thumb: "https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=700&q=80",
    description: "Gastronomia refinada servida à francesa com ingredientes frescos de altíssima qualidade."
  },
  {
    id: 12,
    title: "Coquetelaria Autoral e Drinks Premium",
    category: "buffet",
    categoryLabel: "Buffet",
    image: "https://images.unsplash.com/photo-1551024709-8f23befc6f87?auto=format&fit=crop&w=1200&q=85",
    thumb: "https://images.unsplash.com/photo-1551024709-8f23befc6f87?auto=format&fit=crop&w=700&q=80",
    description: "Mixologia com destilados nobres, taças clássicas e guarnições aromáticas preparadas por bartenders."
  }
];
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fontes Google -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content="pt_BR" />
  </head>
  <body>
    <!-- Cabeçalho Global -->
    <Header activePath="/galeria" />

    <main id="mainContent">
      <!-- 1. Hero da Página -->
      <section class="gallery-hero" aria-label="Apresentação da Galeria">
        <div class="hero-bg-wrapper">
          <img 
            src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=2000&q=85" 
            alt="Galeria de fotografias da Villa Aurora em São Paulo" 
            class="hero-bg-img"
            loading="eager"
            fetchpriority="high"
          />
          <div class="hero-overlay" aria-hidden="true"></div>
        </div>

        <div class="hero-content">
          <span class="hero-eyebrow">Acervo Fotográfico &bull; São Paulo, SP</span>
          <h1 class="hero-title">Inspiração em Cada Detalhe</h1>
          <p class="hero-subtitle">
            Explore registros reais dos nossos ambientes decorados, celebrações marcantes, iluminação cênica e alta gastronomia.
          </p>
          <div class="hero-actions">
            <a href="#mosaico" class="btn-primary">Ver Fotografias</a>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
              Solicitar Orçamento
            </a>
          </div>
        </div>
      </section>

      <!-- 2. Filtros Fotográficos Interativos -->
      <section class="gallery-section" id="mosaico" aria-label="Mosaico de Fotografias">
        <div class="section-container">
          <div class="filter-bar" role="toolbar" aria-label="Filtro de categorias de fotos">
            {categories.map((cat, idx) => (
              <button 
                type="button" 
                class={`filter-btn ${idx === 0 ? 'active' : ''}`}
                data-filter={cat.id}
              >
                {cat.label}
              </button>
            ))}
          </div>

          <!-- 3. Mosaico de Fotografias -->
          <div class="gallery-mosaic" id="galleryMosaic">
            {galleryPhotos.map((photo) => (
              <div 
                class="photo-card" 
                data-category={photo.category}
                data-full-img={photo.image}
                data-title={photo.title}
                data-desc={photo.description}
                data-badge={photo.categoryLabel}
                role="button"
                tabindex="0"
                aria-label={`Ver foto ampliada: ${photo.title}`}
              >
                <div class="card-media">
                  <img 
                    src={photo.thumb} 
                    alt={photo.title} 
                    class="photo-thumb"
                    loading="lazy"
                  />
                  <div class="photo-overlay">
                    <span class="photo-badge">{photo.categoryLabel}</span>
                    <h3 class="photo-title">{photo.title}</h3>
                    <span class="zoom-hint">
                      <svg class="zoom-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        <line x1="11" y1="8" x2="11" y2="14"></line>
                        <line x1="8" y1="11" x2="14" y2="11"></line>
                      </svg>
                      Clique para ampliar
                    </span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 4. Modal Lightbox (Visualização Ampliada) -->
      <div 
        class="lightbox-modal" 
        id="lightboxModal" 
        aria-hidden="true" 
        role="dialog" 
        aria-label="Visualização ampliada de fotografia"
      >
        <div class="lightbox-backdrop" id="lightboxBackdrop"></div>
        <div class="lightbox-container">
          <button 
            type="button" 
            class="lightbox-close" 
            id="lightboxClose" 
            aria-label="Fechar visualização ampliada"
          >
            &times;
          </button>
          
          <div class="lightbox-content">
            <div class="lightbox-image-box">
              <img src="" alt="" id="lightboxImg" class="lightbox-img" />
            </div>
            <div class="lightbox-caption">
              <span class="lightbox-badge" id="lightboxBadge">Categoria</span>
              <h2 class="lightbox-title" id="lightboxTitle">Título da Fotografia</h2>
              <p class="lightbox-desc" id="lightboxDesc">Descrição detalhada da fotografia.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- 5. Banner de Conversão WhatsApp -->
      <section class="cta-section" aria-label="Solicitação de Orçamento">
        <div class="section-container">
          <div class="cta-box">
            <span class="cta-eyebrow">Planejamento Exclusivo</span>
            <h2 class="cta-title">Gostou das Nossas Ambientações?</h2>
            <p class="cta-desc">
              Transforme a sua celebração em um momento memorável. Fale diretamente com nossa equipe via WhatsApp para consultar datas disponíveis e receber uma proposta personalizada.
            </p>
            <div class="cta-actions">
              <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
                Pedir Orçamento via WhatsApp
              </a>
              <a href="/contato" class="btn-secondary">
                Preencher Formulário de Contato
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- Rodapé Global -->
    <Footer />

    <!-- Script de Filtros e Lightbox -->
    <script>
      function setupGallery() {
        const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
        const photoCards = document.querySelectorAll<HTMLElement>('.photo-card');
        const modal = document.getElementById('lightboxModal');
        const modalImg = document.getElementById('lightboxImg') as HTMLImageElement;
        const modalTitle = document.getElementById('lightboxTitle');
        const modalDesc = document.getElementById('lightboxDesc');
        const modalBadge = document.getElementById('lightboxBadge');
        const closeBtn = document.getElementById('lightboxClose');
        const backdrop = document.getElementById('lightboxBackdrop');

        // 1. Lógica dos Filtros de Categoria
        filterBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            filterBtns.forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');

            const filterValue = btn.getAttribute('data-filter');

            photoCards.forEach((card) => {
              const cardCategory = card.getAttribute('data-category');
              if (filterValue === 'todos' || cardCategory === filterValue) {
                card.style.display = 'block';
                setTimeout(() => {
                  card.style.opacity = '1';
                  card.style.transform = 'scale(1)';
                }, 50);
              } else {
                card.style.opacity = '0';
                card.style.transform = 'scale(0.96)';
                setTimeout(() => {
                  card.style.display = 'none';
                }, 250);
              }
            });
          });
        });

        // 2. Abertura do Lightbox
        photoCards.forEach((card) => {
          const openCard = () => {
            const fullImg = card.getAttribute('data-full-img') || '';
            const title = card.getAttribute('data-title') || '';
            const desc = card.getAttribute('data-desc') || '';
            const badge = card.getAttribute('data-badge') || '';

            if (modal && modalImg && modalTitle && modalDesc && modalBadge) {
              modalImg.src = fullImg;
              modalImg.alt = title;
              modalTitle.textContent = title;
              modalDesc.textContent = desc;
              modalBadge.textContent = badge;

              modal.classList.add('is-open');
              modal.setAttribute('aria-hidden', 'false');
              document.body.style.overflow = 'hidden';
            }
          };

          card.addEventListener('click', openCard);
          card.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              openCard();
            }
          });
        });

        // 3. Fechamento do Lightbox
        const closeModal = () => {
          if (modal) {
            modal.classList.remove('is-open');
            modal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
          }
        };

        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        if (backdrop) backdrop.addEventListener('click', closeModal);

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && modal?.classList.contains('is-open')) {
            closeModal();
          }
        });
      }

      setupGallery();
      document.addEventListener('astro:page-load', setupGallery);
    </script>
  </body>
</html>

<style>
  :root {
    --color-onyx: #201A16;
    --color-onyx-card: #2B221D;
    --color-onyx-deep: #17120F;
    --color-gold: #c5a059;
    --color-gold-light: #dfbd74;
    --color-bronze: #8C6D4F;
    --color-bronze-glow: rgba(184, 134, 76, 0.25);
    --color-champagne: #f7f3e9;
    --color-champagne-muted: rgba(247, 243, 233, 0.75);
    --border-gold-subtle: rgba(197, 160, 89, 0.25);
    --border-gold-bright: rgba(197, 160, 89, 0.5);
    --border-bronze-subtle: rgba(163, 126, 88, 0.3);
    --font-heading: 'Cormorant Garamond', 'Playfair Display', Georgia, serif;
    --font-sans: 'Montserrat', system-ui, -apple-system, sans-serif;
  }

  html {
    scroll-behavior: smooth;
    background-color: var(--color-onyx);
  }

  body {
    margin: 0;
    padding: 0;
    font-family: var(--font-sans);
    background-color: var(--color-onyx);
    color: var(--color-champagne-muted);
    line-height: 1.6;
    overflow-x: hidden;
  }

  .section-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Botões */
  .btn-primary {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: #1C1613;
    background: linear-gradient(135deg, var(--color-gold-light) 0%, var(--color-gold) 100%);
    padding: 0.9rem 1.8rem;
    border-radius: 2px;
    border: 1px solid var(--color-gold-light);
    box-shadow: 0 4px 18px rgba(197, 160, 89, 0.22);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    text-align: center;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(197, 160, 89, 0.38);
  }

  .btn-secondary {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.84rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-champagne);
    background: transparent;
    padding: 0.9rem 1.8rem;
    border-radius: 2px;
    border: 1px solid var(--border-gold-subtle);
    transition: border-color 0.25s ease, color 0.25s ease, background-color 0.25s ease;
    text-align: center;
  }

  .btn-secondary:hover {
    border-color: var(--color-gold);
    color: var(--color-gold-light);
    background-color: rgba(197, 160, 89, 0.08);
  }

  /* 1. HERO DA GALERIA */
  .gallery-hero {
    position: relative;
    min-height: 56vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 5rem 1.5rem 4rem;
    overflow: hidden;
  }

  .hero-bg-wrapper {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(32, 26, 22, 0.7) 0%, rgba(32, 26, 22, 0.92) 85%, var(--color-onyx) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 820px;
    margin: 0 auto;
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold);
    border: 1px solid var(--border-gold-subtle);
    background-color: rgba(43, 34, 29, 0.85);
    padding: 0.4rem 1.1rem;
    border-radius: 30px;
    margin-bottom: 1.2rem;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: 2.8rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-champagne);
    margin: 0 0 1.2rem 0;
  }

  .hero-subtitle {
    font-size: 1.05rem;
    color: var(--color-champagne-muted);
    line-height: 1.7;
    margin: 0 auto 2.2rem;
    max-width: 680px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    justify-content: center;
  }

  /* 2. FILTROS */
  .gallery-section {
    padding: 4rem 0 6rem;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    margin-bottom: 3.5rem;
  }

  .filter-btn {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-champagne-muted);
    background-color: var(--color-onyx-card);
    border: 1px solid var(--border-gold-subtle);
    padding: 0.6rem 1.2rem;
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .filter-btn:hover {
    color: var(--color-gold-light);
    border-color: var(--color-gold);
  }

  .filter-btn.active {
    background: linear-gradient(135deg, var(--color-gold-light) 0%, var(--color-gold) 100%);
    color: #1C1613;
    border-color: var(--color-gold-light);
    font-weight: 600;
    box-shadow: 0 2px 10px rgba(197, 160, 89, 0.25);
  }

  /* 3. MOSAICO DE FOTOS */
  .gallery-mosaic {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .photo-card {
    background-color: var(--color-onyx-card);
    border: 1px solid var(--border-gold-subtle);
    border-radius: 2px;
    overflow: hidden;
    cursor: pointer;
    position: relative;
    outline: none;
    transition: transform 0.3s ease, border-color 0.3s ease, opacity 0.25s ease;
  }

  .photo-card:focus-visible {
    border-color: var(--color-gold-light);
    box-shadow: 0 0 0 3px rgba(197, 160, 89, 0.4);
  }

  .photo-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-gold-bright);
  }

  .card-media {
    position: relative;
    height: 300px;
    overflow: hidden;
  }

  .photo-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .photo-card:hover .photo-thumb {
    transform: scale(1.08);
  }

  .photo-overlay {
