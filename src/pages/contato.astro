---
// src/pages/contato.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Contato e Orçamento de Eventos em São Paulo — Villa Aurora";
const pageDescription = "Solicite um orçamento sob medida ou agende uma visita guiada na Villa Aurora. Espaço de eventos e buffet sofisticado em São Paulo - SP com atendimento direto via WhatsApp.";

const whatsappNumber = '5511999999999';
const defaultWhatsappMsg = encodeURIComponent('Olá! Gostaria de conversar com a equipe da Villa Aurora para planejar um evento.');
const directWhatsappUrl = `https://wa.me/${whatsappNumber}?text=${defaultWhatsappMsg}`;

const eventOptions = [
  "Casamento",
  "Festa de 15 Anos",
  "Aniversário",
  "Formatura",
  "Evento Corporativo",
  "Outro Formato"
];

const packageOptions = [
  "Essencial (R$ 1.500)",
  "Clássico (R$ 2.500)",
  "Premium (R$ 4.500)",
  "Exclusivo (R$ 7.500)",
  "Personalizado / Sob Medida"
];

const faqs = [
  {
    q: "Como funciona a solicitação e o envio de orçamento?",
    a: "Após preencher o formulário ou entrar em contato pelo WhatsApp, nossa equipe comercial analisa as necessidades do seu evento (data, número de convidados, pacote e preferências de buffet) e elabora uma proposta detalhada em até 24 horas úteis."
  },
  {
    q: "Como são divididas as formas de pagamento?",
    a: "Oferecemos condições facilitadas de pagamento com entrada e parcelamento do saldo até a data do evento, além de condições especiais com desconto para liquidação à vista via transferência/PIX."
  },
  {
    q: "Como agendar uma visita presencial para conhecer os ambientes?",
    a: "As visitas presenciais guiadas são realizadas com agendamento prévio para garantir atendimento exclusivo. Você pode escolher o melhor horário pelo formulário ou diretamente com nossos consultores no WhatsApp."
  },
  {
    q: "Como funciona a sessão de degustação do buffet?",
    a: "A degustação gastronômica é agendada para noivos e anfitriões após o fechamento da proposta preliminar. Nela, servimos uma prévia das entradas, pratos principais, sobremesas e harmonização para alinhamento fino dos sabores."
  },
  {
    q: "A Villa Aurora conta com gerador de energia e segurança?",
    a: "Sim. Dispomos de grupo gerador próprio de alta potência com acionamento automático de emergência para 100% das instalações (luz, som, climatização e cozinhas), além de equipe especializada de segurança patrimonial e brigadistas."
  }
];
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fontes Google -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content="pt_BR" />
  </head>
  <body>
    <!-- Cabeçalho Global -->
    <Header activePath="/contato" />

    <main id="mainContent">
      <!-- 1. Hero da Página -->
      <section class="contact-hero" aria-label="Apresentação de Contato">
        <div class="hero-bg-wrapper">
          <img 
            src="https://images.unsplash.com/photo-1519167758481-83f550bb49b3?auto=format&fit=crop&w=2000&q=85" 
            alt="Villa Aurora iluminada para recepção elegante em São Paulo" 
            class="hero-bg-img"
            loading="eager"
            fetchpriority="high"
          />
          <div class="hero-overlay" aria-hidden="true"></div>
        </div>

        <div class="hero-content">
          <span class="hero-eyebrow">Atendimento Consultivo &bull; São Paulo, SP</span>
          <h1 class="hero-title">Vamos Começar a Planejar a Sua Celebração?</h1>
          <p class="hero-subtitle">
            Nossa equipe de consultores especializados está à disposição para ouvir suas ideias, apresentar disponibilidade de datas e formular uma proposta exclusiva.
          </p>
          <div class="hero-actions">
            <a href="#formulario-orcamento" class="btn-primary">Preencher Formulário</a>
            <a href={directWhatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
              Conversar no WhatsApp
            </a>
          </div>
        </div>
      </section>

      <!-- 2. Seção Principal: Formulário Inteligente & Bloco de Contato Direto -->
      <section class="contact-main-section" id="formulario-orcamento" aria-label="Formulário e Contato">
        <div class="section-container">
          <div class="contact-grid">
            <!-- Coluna do Formulário -->
            <div class="form-wrapper">
              <span class="section-eyebrow">Proposta sob Medida</span>
              <h2 class="form-main-title">Solicite Seu Orçamento</h2>
              <p class="form-main-desc">
                Preencha os dados abaixo. Você poderá enviar os detalhes diretamente para o nosso WhatsApp oficial com mensagem formatada automaticamente.
              </p>

              <form id="quoteForm" class="quote-form" novalidate>
                <!-- Nome Completo -->
                <div class="form-group">
                  <label for="clientName" class="form-label">Nome Completo *</label>
                  <input 
                    type="text" 
                    id="clientName" 
                    name="clientName" 
                    class="form-input" 
                    placeholder="Seu nome ou dos anfitriões" 
                    required 
                  />
                </div>

                <!-- E-mail e Telefone em linha -->
                <div class="form-row">
                  <div class="form-group">
                    <label for="clientEmail" class="form-label">E-mail Comercial *</label>
                    <input 
                      type="email" 
                      id="clientEmail" 
                      name="clientEmail" 
                      class="form-input" 
                      placeholder="seuemail@exemplo.com" 
                      required 
                    />
                  </div>
                  <div class="form-group">
                    <label for="clientPhone" class="form-label">Telefone / WhatsApp *</label>
                    <input 
                      type="tel" 
                      id="clientPhone" 
                      name="clientPhone" 
                      class="form-input" 
                      placeholder="(11) 90000-0000" 
                      required 
                    />
                  </div>
                </div>

                <!-- Tipo de Evento e Pacote de Interesse -->
                <div class="form-row">
                  <div class="form-group">
                    <label for="eventType" class="form-label">Tipo de Evento *</label>
                    <select id="eventType" name="eventType" class="form-select" required>
                      <option value="" disabled selected>Selecione a ocasião</option>
                      {eventOptions.map((opt) => (
                        <option value={opt}>{opt}</option>
                      ))}
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="packageInterest" class="form-label">Pacote de Interesse</label>
                    <select id="packageInterest" name="packageInterest" class="form-select">
                      <option value="" disabled selected>Selecione uma opção</option>
                      {packageOptions.map((pkg) => (
                        <option value={pkg}>{pkg}</option>
                      ))}
                    </select>
                  </div>
                </div>

                <!-- Data Prevista e Quantidade de Convidados -->
                <div class="form-row">
                  <div class="form-group">
                    <label for="eventDate" class="form-label">Data Prevista *</label>
                    <input 
                      type="date" 
                      id="eventDate" 
                      name="eventDate" 
                      class="form-input" 
                      required 
                    />
                  </div>
                  <div class="form-group">
                    <label for="guestCount" class="form-label">Nº Estimado de Convidados *</label>
                    <input 
                      type="number" 
                      id="guestCount" 
                      name="guestCount" 
                      class="form-input" 
                      placeholder="Ex: 150" 
                      min="10" 
                      max="400" 
                      required 
                    />
                  </div>
                </div>

                <!-- Observações Adicionais -->
                <div class="form-group">
                  <label for="clientNotes" class="form-label">Observações Adicionais</label>
                  <textarea 
                    id="clientNotes" 
                    name="clientNotes" 
                    class="form-textarea" 
                    rows="4" 
                    placeholder="Conte-nos detalhes especiais: preferências gastronômicas, horário pretendido ou se deseja agendar uma visita presencial."
                  ></textarea>
                </div>

                <!-- Botão de Ação com WhatsApp Formatado -->
                <div class="form-actions">
                  <button type="submit" class="btn-whatsapp-submit" id="btnSubmit">
                    <svg class="whatsapp-btn-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.698.077-1.111-.059-.413-.136-.957-.318-1.636-.621-1.396-.624-2.316-2.029-2.387-2.123-.07-.094-.572-.763-.572-1.455 0-.693.363-1.033.493-1.174.13-.141.285-.176.38-.176.095 0 .19.002.273.006.09.004.21-.034.328.25.122.293.418 1.019.454 1.094.036.075.06.163.01.261-.05.098-.075.16-.149.247-.074.086-.156.193-.223.259-.074.074-.151.155-.065.303.086.148.384.633.824 1.025.568.505 1.047.662 1.196.736.149.074.236.062.324-.039.088-.101.378-.44.479-.59.101-.15.203-.126.34-.075.137.051.874.412 1.024.487.15.075.25.112.287.176.037.064.037.371-.107.776zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.662 1.439 5.176L2.25 21.75l4.697-1.164C8.385 21.436 10.129 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18c-1.628 0-3.141-.472-4.414-1.285l-.316-.201-2.778.688.745-2.723-.22-.338C4.167 14.858 3.7 13.483 3.7 12 3.7 7.424 7.424 3.7 12 3.7s8.3 3.724 8.3 8.3-3.724 8.3-8.3 8.3z"/>
                    </svg>
                    <span>Enviar Dados e Abrir no WhatsApp</span>
                  </button>
                  <p class="form-disclaimer">
                    Seus dados são protegidos e utilizados exclusivamente para elaborar a proposta consultiva do seu evento.
                  </p>
                </div>
              </form>
            </div>

            <!-- Coluna de Informações Diretas -->
            <div class="direct-contact-col">
              <!-- Card Atendimento WhatsApp -->
              <div class="info-card highlight-card">
                <span class="info-tag">Atendimento Rápido</span>
                <h3 class="info-card-title">Fale Conosco no WhatsApp</h3>
                <p class="info-card-desc">
                  Prefere uma conversa imediata? Nossos consultores respondem prontamente pelo canal oficial da Villa Aurora.
                </p>
                <a href={directWhatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-primary full-width">
                  Iniciar Conversa no WhatsApp
                </a>
              </div>

              <!-- Card Horários de Visitas -->
              <div class="info-card">
                <h3 class="info-card-title">Horários de Visitas Presenciais</h3>
                <p class="info-card-desc">
                  Conheça o Salão Nobre, Jardim, Lounge Bar e Camarim com acompanhamento exclusivo:
                </p>
                <ul class="schedule-list">
                  <li>
                    <strong>Segunda a Sexta-feira:</strong>
                    <span>09h às 19h (com agendamento prévio)</span>
                  </li>
                  <li>
                    <strong>Sábados:</strong>
                    <span>09h às 14h (conforme agenda de eventos)</span>
                  </li>
                  <li>
                    <strong>Domingos & Feriados:</strong>
                    <span>Sob consulta exclusiva</span>
                  </li>
                </ul>
              </div>

              <!-- Card Contatos Oficiais -->
              <div class="info-card">
                <h3 class="info-card-title">Canais Oficiais</h3>
                <ul class="contacts-list">
                  <li class="contact-line">
                    <span class="c-label">Telefone / WhatsApp:</span>
                    <a href={directWhatsappUrl} target="_blank" rel="noopener noreferrer" class="c-link">
                      (11) 99999-9999
                    </a>
                  </li>
                  <li class="contact-line">
                    <span class="c-label">E-mail Comercial:</span>
                    <a href="mailto:contato@villaauroraeventos.com.br" class="c-link">
                      contato@villaauroraeventos.com.br
                    </a>
                  </li>
                  <li class="contact-line">
                    <span class="c-label">Localização:</span>
                    <span class="c-text">São Paulo - SP &bull; Bairro Nobre com fácil acesso e valet privativo</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. Seção de Localização e Mapa -->
      <section class="location-section" aria-labelledby="locationTitle">
        <div class="section-container">
          <div class="section-header-center">
            <span class="section-eyebrow">Localização Nobre</span>
            <h2 id="locationTitle" class="section-title">Como Chegar à Villa Aurora</h2>
            <p class="section-lead">
              Estrategicamente localizada em área nobre de São Paulo - SP, com fácil acesso pelas principais vias e estrutura de recepção com valet.
            </p>
          </div>

          <div class="location-grid">
            <!-- Informações de Acesso -->
            <div class="access-info-box">
              <h3 class="access-title">Facilidades de Acesso e Comodidade</h3>
              <ul class="access-list">
                <li>
                  <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <div>
                    <strong>Serviço de Valet Coberto:</strong>
                    <p>Embarque e desembarque protegido para chuva ou sol, com equipe de manobristas uniformizados.</p>
                  </div>
                </li>
                <li>
                  <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <div>
                    <strong>Acessibilidade Arquitetônica:</strong>
                    <p>Acesso totalmente nivelado da entrada aos salões, jardim e sanitários adaptados.</p>
                  </div>
                </li>
                <li>
                  <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <div>
                    <strong>Segurança e Discrição:</strong>
                    <p>Monitoramento patrimonial contínuo e controle de acesso reservado na recepção.</p>
                  </div>
                </li>
              </ul>
            </div>

            <!-- Mapa Estilizado / Embed Seguro -->
            <div class="map-wrapper">
              <div class="map-frame">
                <iframe 
                  title="Localização da Villa Aurora em São Paulo - SP"
                  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d117070.0934151322!2d-46.74558284566735!3d-23.57053531093155!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94ce59c8da0aa315%3A0xd59f9431f2c9776a!2zU8OjbyBQYXVsbywgU1A!5e0!3m2!1spt-BR!2sbr!4v1700000000000!5m2!1spt-BR!2sbr" 
                  width="100%" 
                  height="380" 
                  style="border:0;" 
                  allowfullscreen="" 
                  loading="lazy" 
                  referrerpolicy="no-referrer-when-downgrade"
                  class="map-iframe"
                ></iframe>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 4. FAQ — Dúvidas Frequentes -->
      <section class="faq-section" aria-labelledby="faqTitle">
        <div class="section-container">
          <div class="section-header-center">
            <span class="section-eyebrow">Dúvidas Comuns</span>
            <h2 id="faqTitle" class="section-title">Perguntas Frequentes</h2>
            <p class="section-lead">
              Esclareça as dúvidas mais frequentes sobre orçamentos, formas de pagamento, buffet e visitas.
            </p>
          </div>

          <div class="faq-accordion">
            {faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary class="faq-question">
                  <span>{faq.q}</span>
                  <span class="faq-icon" aria-hidden="true">+</span>
                </summary>
                <div class="faq-answer">
                  <p>{faq.a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    </main>

    <!-- Rodapé Global -->
    <Footer />

    <!-- Script de Montagem de Mensagem Personalizada para WhatsApp -->
    <script>
      function setupContactForm() {
        const form = document.getElementById('quoteForm') as HTMLFormElement;
        if (!form) return;

        form.addEventListener('submit', (e) => {
          e.preventDefault();

          const name = (document.getElementById('clientName') as HTMLInputElement)?.value.trim();
          const email = (document.getElementById('clientEmail') as HTMLInputElement)?.value.trim();
          const phone = (document.getElementById('clientPhone') as HTMLInputElement)?.value.trim();
          const eventType = (document.getElementById('eventType') as HTMLSelectElement)?.value;
          const packageInterest = (document.getElementById('packageInterest') as HTMLSelectElement)?.value || 'A definir';
          const eventDate = (document.getElementById('eventDate') as HTMLInputElement)?.value;
          const guestCount = (document.getElementById('guestCount') as HTMLInputElement)?.value;
          const notes = (document.getElementById('clientNotes') as HTMLTextAreaElement)?.value.trim();

          if (!name || !email || !phone || !eventType || !eventDate || !guestCount) {
            alert('Por favor, preencha todos os campos obrigatórios marcados com (*).');
            return;
          }

          // Formatação elegante da data
          const [year, month, day] = eventDate.split('-');
          const formattedDate = `${day}/${month}/${year}`;

          // Montagem do texto estruturado para o WhatsApp
          let msg = `*SOLICITAÇÃO DE ORÇAMENTO — VILLA AURORA*\n\n`;
          msg += `• *Nome:* ${name}\n`;
          msg += `• *E-mail:* ${email}\n`;
          msg += `• *Telefone/WhatsApp:* ${phone}\n`;
          msg += `• *Tipo de Evento:* ${eventType}\n`;
          msg += `• *Pacote de Interesse:* ${packageInterest}\n`;
          msg += `• *Data Prevista:* ${formattedDate}\n`;
          msg += `• *Nº de Convidados:* ${guestCount} pessoas\n`;
          if (notes) {
            msg += `• *Observações:* ${notes}\n`;
          }
          msg += `\n_Mensagem enviada através do site oficial Villa Aurora._`;

          const encodedMsg = encodeURIComponent(msg);
          const whatsappUrl = `https://wa.me/5511999999999?text=${encodedMsg}`;

          // Abrir WhatsApp em nova aba
          window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
        });
      }

      setupContactForm();
      document.addEventListener('astro:page-load', setupContactForm);
    </script>
  </body>
</html>

<style>
  :root {
    --color-onyx: #201A16;
    --color-onyx-card: #2B221D;
    --color-onyx-deep: #17120F;
    --color-gold: #c5a059;
    --color-gold-light: #dfbd74;
    --color-bronze: #8C6D4F;
    --color-bronze-glow: rgba(184, 134, 76, 0.25);
    --color-champagne: #f7f3e9;
    --color-champagne-muted: rgba(247, 243, 233, 0.75);
    --border-gold-subtle: rgba(197, 160, 89, 0.25);
    --border-gold-bright: rgba(197, 160, 89, 0.5);
    --border-bronze-subtle: rgba(163, 126, 88, 0.3);
    --font-heading: 'Cormorant Garamond', 'Playfair Display', Georgia, serif;
    --font-sans: 'Montserrat', system-ui, -apple-system, sans-serif;
  }

  html {
    scroll-behavior: smooth;
    background-color: var(--color-onyx);
  }

  body {
    margin: 0;
    padding: 0;
    font-family: var(--font-sans);
    background-color: var(--color-onyx);
    color: var(--color-champagne-muted);
    line-height: 1.6;
    overflow-x: hidden;
  }

  .section-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Botões */
  .btn-primary {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: #1C1613;
    background: linear-gradient(135deg, var(--color-gold-light) 0%, var(--color-gold) 100%);
    padding: 0.9rem 1.8rem;
    border-radius: 2px;
    border: 1px solid var(--color-gold-light);
    box-shadow: 0 4px 18px rgba(197, 160, 89, 0.22);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    text-align: center;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(197, 160, 89, 0.38);
  }

  .btn-secondary {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.84rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-champagne);
    background: transparent;
    padding: 0.9rem 1.8rem;
    border-radius: 2px;
    border: 1px solid var(--border-gold-subtle);
    transition: border-color 0.25s ease, color 0.25s ease, background-color 0.25s ease;
    text-align: center;
  }

  .btn-secondary:hover {
    border-color: var(--color-gold);
    color: var(--color-gold-light);
    background-color: rgba(197, 160, 89, 0.08);
  }

  .full-width {
    width: 100%;
    box-sizing: border-box;
  }

  /* 1. HERO DE CONTATO */
  .contact-hero {
    position: relative;
    min-height: 54vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 5rem 1.5rem 4rem;
    overflow: hidden;
  }

  .hero-bg-wrapper {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(32, 26, 22, 0.7) 0%, rgba(32, 26, 22, 0.92) 85%, var(--color-onyx) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 820px;
    margin: 0 auto;
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold);
    border: 1px solid var(--border-gold-subtle);
    background-color: rgba(43, 34, 29, 0.85);
    padding: 0.4rem 1.1rem;
    border-radius: 30px;
    margin-bottom: 1.2rem;
  }

